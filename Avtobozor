  state.favoritesOnly = false;
  document.querySelector("#search-input").value = "";
  document.querySelector("#year-filter").value = "";
  document.querySelector("#price-filter").value = "";
  document.querySelectorAll(".category-tab").forEach((tab) => tab.classList.toggle("active", tab.dataset.category === "all"));
  document.querySelector("#favorites-filter").classList.remove("selected");
  renderCars();
}

function applySearchFilters(scrollToResults = false) {
  state.search = document.querySelector("#search-input").value;
  state.year = document.querySelector("#year-filter").value;
  state.price = document.querySelector("#price-filter").value;
  state.favoritesOnly = false;
  document.querySelector("#favorites-filter").classList.remove("selected");
  renderCars();
  if (scrollToResults) document.getElementById("e'lonlar").scrollIntoView({ behavior: "smooth" });
}

document.querySelector("#search-form").addEventListener("submit", (event) => {
  event.preventDefault();
  applySearchFilters(true);
});
document.querySelector("#search-input").addEventListener("input", applySearchFilters);
document.querySelector("#year-filter").addEventListener("change", applySearchFilters);
document.querySelector("#price-filter").addEventListener("change", applySearchFilters);

document.querySelectorAll(".category-tab").forEach((tab) => {
  tab.addEventListener("click", () => {
    state.category = tab.dataset.category;
    state.favoritesOnly = false;
    document.querySelector("#favorites-filter").classList.remove("selected");
    document.querySelectorAll(".category-tab").forEach((item) => item.classList.toggle("active", item === tab));
    renderCars();
  });
});

document.querySelector("#sort-filter").addEventListener("change", (event) => {
  state.sort = event.target.value;
  renderCars();
});

carGrid.addEventListener("click", (event) => {
  const favoriteButton = event.target.closest("[data-favorite]");
  const detailButton = event.target.closest("[data-detail]");
  const buyButton = event.target.closest("[data-buy]");
  if (favoriteButton) {
    const id = Number(favoriteButton.dataset.favorite);
    if (state.favorites.has(id)) state.favorites.delete(id);
    else state.favorites.add(id);
    localStorage.setItem("avtobozor-favorites", JSON.stringify([...state.favorites]));
    renderCars();
  } else if (detailButton) {
    showCarDetails(detailButton.dataset.detail);
  } else if (buyButton) {
    showCarDetails(buyButton.dataset.buy, true);
  }
});

document.querySelector("#favorites-filter").addEventListener("click", (event) => {
  state.favoritesOnly = !state.favoritesOnly;
  event.currentTarget.classList.toggle("selected", state.favoritesOnly);
  renderCars();
  document.getElementById("e'lonlar").scrollIntoView({ behavior: "smooth" });
});

document.querySelector("#clear-filters").addEventListener("click", resetFilters);
document.querySelector("#show-all").addEventListener("click", resetFilters);
document.querySelector("#open-listing").addEventListener("click", showListingForm);
document.querySelector("#open-listing-bottom").addEventListener("click", showListingForm);
document.querySelector("#modal-close").addEventListener("click", closeModal);
modalBackdrop.addEventListener("click", (event) => {
  if (event.target === modalBackdrop || event.target.closest("[data-close-modal]")) closeModal();
});
modalContent.addEventListener("click", (event) => {
  const addButton = event.target.closest("[data-admin-add]");
  const editButton = event.target.closest("[data-admin-edit]");
  const deleteButton = event.target.closest("[data-admin-delete]");
  if (addButton) {
    showAdminCarForm();
  } else if (editButton) {
    showAdminCarForm(editButton.dataset.adminEdit);
  } else if (event.target.closest("[data-admin-back]")) {
    showAdminPanel();
  } else if (event.target.closest("[data-admin-logout]")) {
    showAdminLogin();
  } else if (deleteButton) {
    const car = cars.find((item) => item.id === Number(deleteButton.dataset.adminDelete));
    if (!car || !window.confirm(`${car.make} ${car.model} e'lonini o'chirasizmi?`)) return;
    const carIndex = cars.indexOf(car);
    cars.splice(carIndex, 1);
    state.favorites.delete(car.id);
    localStorage.setItem("avtobozor-favorites", JSON.stringify([...state.favorites]));
    persistCars();
    renderCars();
    showAdminPanel();
    showToast("E'lon o'chirildi.");
  }
});
document.addEventListener("keydown", (event) => {
  if (event.key === "Escape" && !modalBackdrop.hidden) closeModal();
});

modalContent.addEventListener("submit", (event) => {
  if (event.target.id === "admin-login-form") {
    event.preventDefault();
    const formData = new FormData(event.target);
    if (formData.get("username") === "islom" && formData.get("password") === "islom") {
      showAdminPanel();
    } else {
      showToast("Login yoki parol noto'g'ri.");
      event.target.reset();
      modalContent.querySelector("#admin-username").focus();
    }
    return;
  }

  if (event.target.id === "admin-car-form") {
    event.preventDefault();
    if (!event.target.reportValidity()) return;

    const formData = new FormData(event.target);
    const imageInput = String(formData.get("image") || "").trim();
    let image = "https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=900&q=82";
    if (imageInput) {
      try {
        const parsedImage = new URL(imageInput);
        if (parsedImage.protocol !== "https:") {
          showToast("Rasm havolasi https:// bilan boshlanishi kerak.");
          return;
        }
        image = parsedImage.href;
      } catch {
        showToast("Rasm havolasi noto'g'ri kiritildi.");
        return;
      }
    }

    const carId = event.target.dataset.carId;
    const existingCar = carId ? cars.find((car) => car.id === Number(carId)) : null;
    const updatedCar = {
      id: existingCar ? existingCar.id : Date.now(),
      make: String(formData.get("make")).trim(),
      model: String(formData.get("model")).trim(),
      year: Number(formData.get("year")),
      price: Number(formData.get("price")),
      category: String(formData.get("category")),
      city: String(formData.get("city")).trim(),
      phone: String(formData.get("phone") || "").trim(),
      mileage: String(formData.get("mileage") || "Ma'lumot yo'q").trim(),
      fuel: String(formData.get("fuel") || "Benzin").trim(),
      gearbox: String(formData.get("gearbox") || "Avtomat").trim(),
      condition: String(formData.get("condition") || "Yaxshi").trim(),
      badge: existingCar ? existingCar.badge || "" : "YANGI",
      featured: existingCar ? Boolean(existingCar.featured) : false,
      image,
      description: String(formData.get("description") || "").trim()
    };

    if (existingCar) {
      Object.assign(existingCar, updatedCar);
    } else {
      cars.unshift(updatedCar);
    }
    persistCars();
    renderCars();
    showAdminPanel();
    showToast(existingCar ? "E'lon yangilandi." : "Yangi mashina qo'shildi.");
    return;
  }

  if (event.target.id !== "listing-form") return;
  event.preventDefault();
  if (!event.target.reportValidity()) return;

  const formData = new FormData(event.target);
  const imageInput = String(formData.get("image") || "").trim();
  let image = "https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=900&q=82";
  if (imageInput) {
    try {
      const parsedImage = new URL(imageInput);
      if (parsedImage.protocol !== "https:") {
        showToast("Rasm havolasi https:// bilan boshlanishi kerak.");
        return;
      }
      image = parsedImage.href;
    } catch {
      showToast("Rasm havolasi noto'g'ri kiritildi.");
      return;
    }
  }

  const newCar = {
    id: Date.now(),
    make: String(formData.get("make")).trim(),
    model: String(formData.get("model")).trim(),
    year: Number(formData.get("year")),
    price: Number(formData.get("price")),
    category: String(formData.get("category")),
    city: String(formData.get("city")).trim(),
    phone: String(formData.get("phone")).trim(),
    mileage: "Ma'lumot yo'q",
    fuel: "Batafsil",
    gearbox: "Batafsil",
    condition: "E'lon yangi",
    badge: "YANGI",
    featured: false,
    image,
    description: "Sotuvchi bilan bog'lanib, avtomobil haqida batafsil ma'lumot oling."
  };
  cars.unshift(newCar);
  persistCars();
  closeModal();
  resetFilters();
  document.getElementById("e'lonlar").scrollIntoView({ behavior: "smooth" });
  showToast("E'loningiz muvaffaqiyatli qo'shildi!");
});

const menuToggle = document.querySelector("#menu-toggle");
document.querySelector("#open-admin").addEventListener("click", () => {
