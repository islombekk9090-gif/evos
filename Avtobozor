const carsStorageKey = "avtobozor-cars";
const savedCars = localStorage.getItem(carsStorageKey);
const cars = savedCars ? JSON.parse(savedCars) : [...defaultCars];
const state = {
  category: "all",
  search: "",
  year: "",
  price: "",
  sort: "featured",
  favoritesOnly: false,
  favorites: new Set(JSON.parse(localStorage.getItem("avtobozor-favorites") || "[]"))
};

const carGrid = document.querySelector("#car-grid");
const emptyState = document.querySelector("#empty-state");
const modalBackdrop = document.querySelector("#modal-backdrop");
const modalContent = document.querySelector("#modal-content");
const toast = document.querySelector("#toast");
let toastTimer;

function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, (character) => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
  })[character]);
}

function formatPrice(price) {
  return new Intl.NumberFormat("en-US").format(price);
}

function persistCars() {
  localStorage.setItem(carsStorageKey, JSON.stringify(cars));
}

function getVisibleCars() {
  let visible = cars.filter((car) => {
    const query = state.search.trim().toLocaleLowerCase();
    const matchesText = !query || `${car.make} ${car.model} ${car.city}`.toLocaleLowerCase().includes(query);
    const year = Number(state.year);
    let matchesYear = !year;
    if (year === 2024) matchesYear = car.year >= 2024;
    if (year === 2020) matchesYear = car.year >= 2020 && car.year <= 2023;
    if (year === 2015) matchesYear = car.year >= 2015 && car.year <= 2019;
    if (year === 2000) matchesYear = car.year <= 2014;
    const price = Number(state.price);
    const matchesPrice = !price || (price === 40001 ? car.price > 40000 : car.price <= price);
    const matchesCategory = state.category === "all" || car.category === state.category;
    return matchesText && matchesYear && matchesPrice && matchesCategory && (!state.favoritesOnly || state.favorites.has(car.id));
  });

  if (state.sort === "price-low") visible.sort((a, b) => a.price - b.price);
  if (state.sort === "price-high") visible.sort((a, b) => b.price - a.price);
  if (state.sort === "year") visible.sort((a, b) => b.year - a.year);
  if (state.sort === "featured") visible.sort((a, b) => Number(b.featured) - Number(a.featured));
  return visible;
}

function carCard(car) {
  const isFavorite = state.favorites.has(car.id);
  const badge = car.badge
    ? `<span class="car-tag ${car.featured ? "tag-featured" : ""}">${escapeHTML(car.badge)}</span>`
    : "";
  return `
    <article class="car-card">
      <div class="car-image-wrap">
        <img class="car-image" src="${escapeHTML(car.image)}" alt="${escapeHTML(`${car.make} ${car.model}`)}" loading="lazy">
        ${badge}
        <button class="favorite-button ${isFavorite ? "is-favorite" : ""}" type="button" data-favorite="${car.id}" aria-label="${isFavorite ? "Saralanganlardan olib tashlash" : "Saralanganlarga qo'shish"}" aria-pressed="${isFavorite}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"/></svg>
        </button>
      </div>
      <div class="car-content">
        <span class="car-year">${car.year} · ${escapeHTML(car.city)}</span>
        <div class="car-title-row"><h3 class="car-title">${escapeHTML(car.make)} ${escapeHTML(car.model)}</h3><span class="car-condition">${escapeHTML(car.condition)}</span></div>
        <div class="car-specs">
          <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18m-5-3 5 3 5-3M7 6l5-3 5 3"/></svg>${escapeHTML(car.mileage)}</span>
          <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v15M4 15h12m3-8v6a2 2 0 0 0 4 0V9l-3-3"/></svg>${escapeHTML(car.fuel)}</span>
        </div>
        <div class="car-footer"><div class="car-price">${formatPrice(car.price)}<small>$</small></div><button class="detail-link" type="button" data-detail="${car.id}" aria-label="${escapeHTML(car.make)} ${escapeHTML(car.model)} haqida batafsil">↗</button></div>
        <button class="button button-orange buy-button" type="button" data-buy="${car.id}">Sotib olish <span aria-hidden="true">→</span></button>
      </div>
    </article>`;
}

function renderCars() {
  const visibleCars = getVisibleCars();
  carGrid.innerHTML = visibleCars.map(carCard).join("");
  emptyState.hidden = visibleCars.length > 0;
  carGrid.hidden = visibleCars.length === 0;
  document.querySelector("#favorite-count").textContent = state.favorites.size;
  document.querySelector("#inventory-count").textContent = String(cars.length).padStart(2, "0");
}

function showToast(message) {
  toast.textContent = message;
  toast.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove("show"), 2600);
}

function openModal(content, wide = false) {
  modalContent.innerHTML = content;
  modalBackdrop.querySelector(".modal-card").classList.toggle("modal-card-wide", wide);
  modalBackdrop.hidden = false;
  document.body.style.overflow = "hidden";
  modalBackdrop.querySelector(".modal-close").focus();
}

function closeModal() {
  modalBackdrop.hidden = true;
  document.body.style.overflow = "";
}

function showCarDetails(id, isPurchase = false) {
  const car = cars.find((item) => item.id === Number(id));
  if (!car) return;
  const phone = car.phone || "+998712001020";
  const contactLabel = car.phone ? "Sotuvchiga qo'ng'iroq" : "Maslahat olish";
  const contactNote = car.phone
    ? "Avtomobil egasi bilan bevosita bog'lanib, xaridni kelishib oling."
    : "Bu namunaviy e'londa sotuvchi raqami yo'q. Xarid bo'yicha yordam uchun AvtoBozor bilan bog'laning.";
  openModal(`
    <img class="detail-image" src="${escapeHTML(car.image)}" alt="${escapeHTML(`${car.make} ${car.model}`)}">
    <div class="eyebrow"><span class="eyebrow-dot"></span> ${car.year} · ${escapeHTML(car.city)}</div>
    <h2 class="modal-heading" id="modal-title">${isPurchase ? "Sotib olish: " : ""}${escapeHTML(car.make)} ${escapeHTML(car.model)}</h2>
    <div class="detail-meta"><span>${escapeHTML(car.mileage)}</span><span>${escapeHTML(car.fuel)}</span><span>${escapeHTML(car.gearbox)}</span><span>${escapeHTML(car.condition)}</span></div>
    <p class="detail-price">${formatPrice(car.price)} $</p>
    <p class="detail-description">${escapeHTML(car.description || "Sotuvchi bilan bog'lanib, avtomobil haqida batafsil ma'lumot oling.")}</p>
    <p class="detail-description">${escapeHTML(contactNote)}</p>
    <div class="detail-contact"><a class="button button-orange" href="tel:${escapeHTML(phone)}">☎ ${contactLabel}</a><button class="button button-dark" type="button" data-close-modal>Yopish</button></div>`);
}

